# docker compose용 현장별 값. 이 파일을 .env로 복사한 뒤 CHANGE_ME를 교체한다.
APP_TAG=1.0.0
SPRING_PROFILES_ACTIVE=prod

# Host 공개 포트: DB/Influx는 Compose 내부에서만 사용하고 Host에 노출하지 않는다.
MANAGER_HOST_PORT=8080
MQTT_HOST_PORT=1883

# MariaDB
MARIADB_DATABASE=dcim
MARIADB_HOST=mariadb
MARIADB_PORT=3306
DB_USER=dcim
DB_PASS=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# InfluxDB 초기 관리자와 Manager/Sensor Data 공용 토큰
INFLUX_ADMIN_USERNAME=dcim-admin
INFLUX_ADMIN_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=vivans
INFLUX_BUCKET=dcim
INFLUX_MEASUREMENT=dcim_sensor
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086

# 서비스 간 인증과 Manager 로그인
COLLECTOR_API_KEY=CHANGE_ME
SENSOR_DATA_API_KEY=CHANGE_ME
MANAGER_API_KEY=sensor-data-service
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRATION=63072000
REFRESH_TOKEN_EXPIRATION=78840000

# MQTT topic
MQTT_TOPIC=dcim/sensor/data
MQTT_REALTIME_TOPIC=dcim/sensor/realtime
MQTT_PUE_TOPIC=dcim/derived/pue
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mqtt:1883
MQTT_HOST=mqtt
MQTT_PORT=1883
COLLECTOR_MQTT_CLIENT_ID=defog-collector
SENSOR_DATA_MQTT_CLIENT_ID=defog-sensor-data

# Compose 내부 서비스 주소
COLLECTOR_SERVICE_URL=http://collector:8081
SENSOR_DATA_SERVICE_URL=http://sensor-data:8082
MANAGER_SERVICE_URL=http://manager:8080
MANAGER_LOOKUP_ENABLED=true
SENSOR_DATA_HEALTH_ENABLED=true
MQTT_HEALTH_ENABLED=true
OPERATIONS_HEALTH_TIMEOUT_MILLIS=2000

# 컨테이너 로그·파일 경로
LOG_FILE_NAME=/app/log/application.log
ASSET_IMAGE_STORAGE_PATH=/app/assets/images
ASSET_DOCUMENT_STORAGE_PATH=/app/assets/documents
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=20MB

# Host 데이터 경로. 상대 경로를 유지하면 compose 파일 기준 runtime/에 생성된다.
MANAGER_RUNTIME_PATH=./runtime/manager
COLLECTOR_RUNTIME_PATH=./runtime/collector
SENSOR_DATA_RUNTIME_PATH=./runtime/sensor-data
