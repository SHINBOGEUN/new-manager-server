# docker compose용 현장별 값. 이 파일을 .env로 복사한 뒤 CHANGE_ME를 교체한다.
APP_TAG=1.0.1-new
# Collector는 버전이 따로 올라간다(Sensor Data 통합 이후 1.1.0-new부터).
COLLECTOR_APP_TAG=1.1.0-new
SPRING_PROFILES_ACTIVE=prod

# Host 공개 포트: DB/Influx는 Compose 내부에서만 사용하고 Host에 노출하지 않는다.
MANAGER_HOST_PORT=8080
MQTT_HOST_PORT=1883
MQTT_WEBSOCKET_HOST_PORT=9001

# MariaDB
MARIADB_DATABASE=dcim
MARIADB_HOST=mariadb
MARIADB_PORT=3306
DB_USER=dcim
DB_PASS=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# InfluxDB 초기 관리자와 Manager/Collector 공용 토큰
INFLUX_ADMIN_USERNAME=dcim-admin
INFLUX_ADMIN_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=vivans
INFLUX_BUCKET=dcim
INFLUX_MEASUREMENT=dcim_sensor
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086

# 서비스 간 인증과 Manager 로그인 (서비스 키는 2개, 서로 다른 강한 무작위 값)
# Manager -> Collector(수집 Job·MQTT 수신 동기화). Manager와 Collector에 같은 값.
COLLECTOR_API_KEY=CHANGE_ME
# Collector -> Manager(장비·MQTT 설정 조회, 알람 측정값, GPU 등록). Manager와 Collector에 같은 값.
MANAGER_API_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_KEY
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRATION=63072000
REFRESH_TOKEN_EXPIRATION=78840000

# MQTT topic
MQTT_TOPIC=dcim/sensor/data
MQTT_REALTIME_TOPIC=dcim/sensor/realtime
MQTT_PUE_TOPIC=dcim/derived/pue
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mqtt:1883
MQTT_HOST=mqtt
MQTT_PORT=1883
# Collector 발행용/수신용 MQTT client id. 반드시 서로 달라야 한다.
COLLECTOR_MQTT_CLIENT_ID=defog-collector
COLLECTOR_INGEST_MQTT_CLIENT_ID=defog-collector-ingest
# MQTT 수신 -> InfluxDB 저장(구 Sensor Data). 구 Sensor Data와 병행하는 전환 기간에만 false.
INGEST_ENABLED=true

# Compose 내부 서비스 주소
COLLECTOR_SERVICE_URL=http://collector:8081
MANAGER_SERVICE_URL=http://manager:8080
MANAGER_LOOKUP_ENABLED=true
MQTT_HEALTH_ENABLED=true
OPERATIONS_HEALTH_TIMEOUT_MILLIS=2000

# 컨테이너 로그·파일 경로
LOG_FILE_NAME=/app/log/application.log
ASSET_IMAGE_STORAGE_PATH=/app/assets/images
ASSET_DOCUMENT_STORAGE_PATH=/app/assets/documents
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=20MB

# Host 데이터 경로. 상대 경로를 유지하면 compose 파일 기준 runtime/에 생성된다.
MANAGER_RUNTIME_PATH=./runtime/manager
COLLECTOR_RUNTIME_PATH=./runtime/collector

# 수집 및 화면 기본 동작 (기간은 ISO-8601 형식)
SNMP_COMMUNITY=public
COLLECTION_TIMEOUT_MS=2000
COLLECTION_RETRIES=1
COLLECTION_MAX_CONCURRENCY=10
LIVE_INTERVAL_MS=1000
LIVE_TIMEOUT_MS=800
LIVE_RETRIES=0
LIVE_MAX_CONCURRENCY=10
ALARM_MAX_SAMPLE_AGE=PT5M
COLLECTION_LATEST_LOOKBACK_HOURS=168
WIDGET_LATEST_LOOKBACK=PT24H
WIDGET_ENVIRONMENTAL_SOURCES=8
EQUIPMENT_VALUE_WIDGETS=20

# 랙 전력 위젯 기준(DEVICE_TYPE 코드, 이중화 경로 코드 2개)
RACK_POWER_DEVICE_TYPES=PDU
RACK_REDUNDANT_PATHS=A,B

# 보안
# 공개 회원가입(false 권장): false면 빈 DB의 첫 계정만 가입되어 ADMIN이 되고 이후 계정은 관리자가 만든다.
PUBLIC_REGISTRATION_ENABLED=false
# 다른 주소의 화면(React 개발 서버 등)에서 API·WebSocket을 쓰면 그 주소를 쉼표로 지정한다. 기본 *.
CORS_ALLOWED_ORIGINS=*
# prod 프로필은 Swagger를 기본으로 끈다.
SWAGGER_ENABLED=false
