<mxfile host="app.diagrams.net" agent="cursor" version="22.1.0">
  <diagram id="collection-task-register-flow" name="수집 Task 등록 프로세스">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="수집 Task 등록 프로세스 (feat/collection-task)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="산출물: 그룹 JSON spec (JS 스크립트 아님). collector 연동은 아직 없음." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="720" height="24" as="geometry" />
        </mxCell>

        <!-- ===== 1. 시드 ===== -->
        <mxCell id="lane1" value="1. 설치 시드" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;startSize=32;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="920" height="130" as="geometry" />
        </mxCell>
        <mxCell id="start" value="시작" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane1">
          <mxGeometry x="50" y="40" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="codes" value="공통코드 시드&#xa;LOCATION / MODEL / PROTOCOL / DEVICE_PAGE&#xa;(V017)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane1">
          <mxGeometry x="180" y="30" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="unassigned" value="위치 UNASSIGNED 노드&#xa;(V004 시드)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane1">
          <mxGeometry x="450" y="30" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane1" source="start" target="codes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane1" source="codes" target="unassigned">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 2. 카탈로그 ===== -->
        <mxCell id="lane2" value="2. 모델 카탈로그" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontStyle=1;startSize=32;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="920" height="140" as="geometry" />
        </mxCell>
        <mxCell id="location" value="위치 트리 등록&#xa;ZONE / RACK 등" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="35" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="model" value="장비 모델 등록&#xa;유형=PDU + 프로토콜=snmp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane2">
          <mxGeometry x="260" y="35" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="points" value="모델 SNMP point 등록&#xa;OID / unit / requiresInstance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane2">
          <mxGeometry x="510" y="35" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="unassigned" target="location">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane2" source="location" target="model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane2" source="model" target="points">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 3. Task ===== -->
        <mxCell id="lane3" value="3. 수집 Task" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;fontStyle=1;startSize=32;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="920" height="220" as="geometry" />
        </mxCell>
        <mxCell id="hasTask" value="이 모델의&#xa;SNMP Task가&#xa;이미 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane3">
          <mxGeometry x="50" y="55" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="createTask" value="Task 생성&#xa;modelId + scriptType=snmp&#xa;그룹 없으면 '기본 그룹' 1분 cron 생성&#xa;미편입 장비 전부 기본 그룹에 편입" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="lane3">
          <mxGeometry x="250" y="40" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="taskExists" value="기존 Task 사용&#xa;그룹이 여러 개면&#xa;첫 번째 active 그룹이 기본 그룹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="lane3">
          <mxGeometry x="250" y="140" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="taskReady" value="Task 준비됨&#xa;모델 1 + 프로토콜 1 = Task 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddb1;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="590" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="points" target="hasTask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="없음" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane3" source="hasTask" target="createTask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="있음" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane3" source="hasTask" target="taskExists">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane3" source="createTask" target="taskReady">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane3" source="taskExists" target="taskReady">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 4. 장비 ===== -->
        <mxCell id="lane4" value="4. 현장 장비" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontStyle=1;startSize=32;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="920" height="250" as="geometry" />
        </mxCell>
        <mxCell id="device" value="장비 등록&#xa;devices (model + location)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane4">
          <mxGeometry x="50" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="assign" value="모델 Task 기본 그룹에&#xa;자동 편입 + spec 재생성&#xa;(Task 없으면 편입 안 함)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane4">
          <mxGeometry x="280" y="30" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="endpoint" value="SNMP endpoint 등록&#xa;host / port / enabled&#xa;예: 192.168.14.114:161" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane4">
          <mxGeometry x="550" y="30" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="needInst" value="모델 point 중&#xa;requiresInstance&#xa;= true 인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane4">
          <mxGeometry x="280" y="130" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="instance" value="device_snmp_instance 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane4">
          <mxGeometry x="500" y="145" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="taskReady" target="device">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane4" source="device" target="assign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane4" source="assign" target="endpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane4" source="endpoint" target="needInst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane4" source="needInst" target="instance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 5. spec ===== -->
        <mxCell id="lane5" value="5. spec" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;startSize=32;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="920" height="220" as="geometry" />
        </mxCell>
        <mxCell id="regen" value="그룹 JSON spec 재생성&#xa;collection_task_group.generated_spec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="lane5">
          <mxGeometry x="50" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="collectible" value="이 장비가&#xa;targets에&#xa;들어가나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane5">
          <mxGeometry x="360" y="25" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="inTargets" value="targets에 포함&#xa;deviceId, host, port, instanceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane5">
          <mxGeometry x="560" y="20" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="skipped" value="skipped에 이유 기록&#xa;Task 생성은 실패하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane5">
          <mxGeometry x="560" y="85" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="종료&#xa;spec은 DB에만 저장. collector 등록은 아직 없음" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane5">
          <mxGeometry x="300" y="145" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="needInst" target="regen">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="870" />
              <mxPoint x="250" y="980" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16b" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="needInst" target="regen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="instance" target="regen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane5" source="regen" target="collectible">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane5" source="collectible" target="inTargets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane5" source="collectible" target="skipped">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane5" source="inTargets" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="lane5" source="skipped" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 오른쪽 노트 ===== -->
        <mxCell id="noteRegen" value="&lt;b&gt;spec이 다시 만들어지는 때&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 장비 등록/수정/삭제, 모델 변경&lt;br&gt;• endpoint CUD&lt;br&gt;• SNMP instance CUD&lt;br&gt;• 모델 SNMP point CUD&lt;br&gt;• 모델 프로토콜 교체&lt;br&gt;• Task 생성 / 그룹 CUD&lt;br&gt;&lt;br&gt;Task·그룹 toggle 은 spec 안 바꿈" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="90" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="noteSkip" value="&lt;b&gt;targets에서 skip 되는 경우&lt;/b&gt;&lt;br&gt;&lt;br&gt;• devices.enabled = false&lt;br&gt;• SNMP endpoint 없음 / enabled=false&lt;br&gt;• requiresInstance 인데 instance 없음&lt;br&gt;• 수집 가능한 point 0개&lt;br&gt;• scriptType이 snmp가 아님&lt;br&gt;&lt;br&gt;생성 API는 성공하고 skipped 에 이유만 남김" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="330" width="280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="noteRule" value="&lt;b&gt;핵심 제약&lt;/b&gt;&lt;br&gt;&lt;br&gt;• (model_id, script_type_id) Task 1개&lt;br&gt;• 모델이 해당 프로토콜을 가져야 함&lt;br&gt;• 같은 Task 안 cron 중복 불가&lt;br&gt;• 한 장비는 그 Task에서 그룹 1개만&lt;br&gt;• 장비 model = Task model&lt;br&gt;• host+port 전역 유니크&lt;br&gt;• spec community=public 고정&lt;br&gt;• 실제 SNMP는 collector 미연동" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="560" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="noteOrder" value="&lt;b&gt;순서 참고&lt;/b&gt;&lt;br&gt;&lt;br&gt;권장: Task를 먼저 만들고 장비를 등록하면 즉시 편입됨.&lt;br&gt;&lt;br&gt;장비를 먼저 만들어도 됨. 나중에 Task를 만들면 미편입 장비를 기본 그룹에 넣음.&lt;br&gt;&lt;br&gt;endpoint는 장비 다음에만 등록 가능.&lt;br&gt;instance는 requiresInstance point가 있을 때만." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="800" width="280" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
